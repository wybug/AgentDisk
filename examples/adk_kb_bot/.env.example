# AgentDisk 服务地址
AGENTDISK_BASE_URL=http://localhost:8080

# API Key（管理后台创建；OKF 读 API 同时接受 API Key 或 JWT token，
# 这里与 writer 保持一致用 API Key，省去另开账号）
AGENTDISK_API_KEY=adk_xxx

# 知识库配置 —— bot 启动时把这两个值"焊"进 agent 的工具默认参数里：
#   KB_BOT_BUNDLE_ID                指定 agent 默认检索的 OKF bundle（数字）
#   AGENTDISK_PUBLIC_DIRECTORY_ID   PD 的 id（数字，与 writer 共用同一变量名）
#                                   读取节点正文时按 id 解析 displayName，
#                                   再拼出 "<displayName>/<rel_path>" 走 SDK 下载。
# 没填的话：agent 每次都得显式传 bundle_id；read_node_content 不可用
KB_BOT_BUNDLE_ID=
AGENTDISK_PUBLIC_DIRECTORY_ID=

# 兼容回退：老 .env 用 displayName 而非 id 时仍可工作（多一次 list 调用）。
# 新部署请直接用上面的 AGENTDISK_PUBLIC_DIRECTORY_ID。
# KB_BOT_PUBLIC_DIRECTORY_NAME=test

# 模型选择 —— LiteLLM model id 形式，与 writer 同语义：
#   deepseek/deepseek-chat       (默认推荐)
#   gemini-2.5-flash
#   claude-sonnet-4
#   ollama/llama3
KB_BOT_MODEL=deepseek/deepseek-chat

# 模型 API Key —— 按 KB_BOT_MODEL 填一个
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/beta
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 评估模式（evals/）—— 见 evals/README.md
# 跑 `make kb-bot-eval` 时上面的 AGENTDISK_* + KB_BOT_* 变量必须真实有效，
# 加上 DEEPSEEK_API_KEY（或对应模型的 key）。
# baseline_results.md 用来追踪 prompt / 工具变化对 agent 决策的影响。
