# AgentDisk 服务地址
AGENTDISK_BASE_URL=http://localhost:8080

# 公共目录 —— 二选一（PATH 更直观，UI 里能直接看到）：
#   AGENTDISK_PUBLIC_DIRECTORY_ID    数字 ID（preferred，零开销）
#   AGENTDISK_PUBLIC_DIRECTORY_PATH  路径（首次解析时多一次 GET /v1/disk/public-directories）
# 两个都填时以 ID 为准。
AGENTDISK_PUBLIC_DIRECTORY_ID=
AGENTDISK_PUBLIC_DIRECTORY_PATH=/public/test

# API Key（管理后台创建，scope 含 okf-write）
AGENTDISK_API_KEY=adk_xxx

# Raw 文件根目录（"从本地 raw 文件初始化知识库"流程的扫描根）
# 不设置时默认指向包内 examples/adk_writer_agent/raw/（含示例法规文档）
# 指向外部目录时设为绝对路径，如 /home/me/notes
# list_raw_files / read_raw_file 工具基于此根做相对路径解析与越界保护
# AGENTDISK_RAW_ROOT=

# 模型选择 —— LiteLLM model id 形式：
#   deepseek/deepseek-chat       (DeepSeek 官方，默认推荐)
#   deepseek/deepseek-reasoner   (DeepSeek Reasoner，思考模型)
#   gemini-2.5-flash             (Google Gemini，需要 GEMINI_API_KEY)
#   claude-sonnet-4              (Anthropic Claude，需要 ANTHROPIC_API_KEY)
#   ollama/llama3                (本地 Ollama)
WRITER_AGENT_MODEL=deepseek/deepseek-chat

# 模型 API Key —— 按 WRITER_AGENT_MODEL 填一个
# DeepSeek 官方：只需要 DEEPSEEK_API_KEY，URL 默认 https://api.deepseek.com/beta
# 用代理/自建端点时才需要 DEEPSEEK_API_BASE
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/beta
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama 不需要 key，但需要 OLLAMA_BASE_URL（默认 http://localhost:11434）

# 评估模式（evals/）—— 见 evals/README.md
# 跑 `make okf-eval` 时上面三个 AGENTDISK_* 变量必须真实有效（不能 mock），
# 加上 DEEPSEEK_API_KEY（或对应模型的 key）。
# baseline_results.md 用来追踪 prompt / 工具变化对 agent 决策的影响。
