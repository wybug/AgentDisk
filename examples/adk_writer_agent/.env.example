# AgentDisk 服务地址
AGENTDISK_BASE_URL=http://localhost:8080

# 公共目录 ID（管理员预先创建好的 public directory）
AGENTDISK_PUBLIC_DIRECTORY_ID=1

# API Key（管理后台创建，scope 含 okf-write）
AGENTDISK_API_KEY=adk_xxx

# 模型选择：gemini-2.5-flash | claude-sonnet-4 | deepseek-v4 | ollama/llama3
WRITER_AGENT_MODEL=gemini-2.5-flash

# 模型 API Key（按 WRITER_AGENT_MODEL 填一个）
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Ollama 不需要 key，但需要 OLLAMA_BASE_URL（默认 http://localhost:11434）
